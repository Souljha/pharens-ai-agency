# Supabase Configuration
PUBLIC_SUPABASE_URL=your-supabase-url-here
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# OpenAI Configuration (optional - for future AI features)
OPENAI_API_KEY=your-openai-api-key-here

# Ollama Configuration (optional - leave empty to use fallback responses)
# Only needed if you want to use Ollama for AI chatbot responses
OLLAMA_BASE_URL=

# Google Analytics (optional - for tracking)
PUBLIC_GA_MEASUREMENT_ID=

# Vapi AI Voice Agent Configuration
# Get your credentials from https://vapi.ai
# PUBLIC_VAPI_PUBLIC_KEY: Used for web-based calls (browser SDK)
# VAPI_PRIVATE_API_KEY: Used for outbound phone calls (server-side only, keep secret!)
# VAPI_PHONE_NUMBER_ID: Your Twilio phone number ID from Vapi (for outbound calls)
PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key-here
PUBLIC_VAPI_ASSISTANT_ID=your-vapi-assistant-id-here
VAPI_PRIVATE_API_KEY=your-vapi-private-api-key-here
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id-here

# Paystack Payment Configuration
# Get your credentials from https://paystack.com
# PUBLIC_PAYSTACK_PUBLIC_KEY: Used for client-side payment popup (safe to expose)
# PAYSTACK_SECRET_KEY: Used for server-side payment verification (keep secret!)
PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key-here
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here

# Resend Email Service
# Get your API key from https://resend.com
# RESEND_API_KEY: Used for sending transactional emails (keep secret!)
RESEND_API_KEY=your-resend-api-key-here

# Retell AI Voice Agent Configuration
# Get your credentials from https://retellai.com
# Used for the floating "Call Me Back" widget demonstration
# PUBLIC_RETELL_PUBLIC_KEY: Your public API key (safe to expose)
# PUBLIC_RETELL_AGENT_ID: Your agent ID for the widget
# PUBLIC_RETELL_PHONE_NUMBER: Your Retell phone number for callbacks (e.g., +15550000000)
# PUBLIC_RETELL_WIDGET_TITLE: Custom title for the widget (e.g., "Talk to Sarah")
# PUBLIC_RETELL_ENABLED: Set to 'true' to enable the widget, 'false' to disable
PUBLIC_RETELL_PUBLIC_KEY=your-retell-public-key-here
PUBLIC_RETELL_AGENT_ID=your-retell-agent-id-here
PUBLIC_RETELL_PHONE_NUMBER=+15550000000
PUBLIC_RETELL_WIDGET_TITLE=Talk to Our AI Agent
PUBLIC_RETELL_ENABLED=false
